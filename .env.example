# Redis (must match docker-compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# Postgres (thumbnail metadata)
# Either DATABASE_URL or discrete POSTGRES_* vars
# DATABASE_URL=postgres://thumbnail:changeme_postgres@127.0.0.1:5432/thumbnail_generator
POSTGRES_HOST=127.0.0.1
# Also the host port docker-compose publishes; change it if 5432 is taken locally
POSTGRES_PORT=5432
POSTGRES_USER=thumbnail
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=thumbnail_generator

# Logging: DEBUG | INFO | WARN | ERROR | FATAL | SILENT
LOG_LEVEL=INFO

# Scanner
VIDEO_SCAN_PATH=./data/videos
# 0 = scan once and exit; >0 = daemon interval in ms
SCAN_INTERVAL_MS=0
# Re-enqueue BullMQ jobs that already exhausted retries (dangerous for corrupt files)
REQUEUE_FAILED_JOBS=false

# Generator / scanner (shared storage path so scanner can detect missing objects)
THUMBNAIL_STORAGE_PATH=./data/thumbnails
# Jobs processed in parallel per worker process
WORKER_CONCURRENCY=2
# Shared ffmpeg wall-clock budget across all seek attempts (ms)
FFMPEG_TIMEOUT_MS=120000
# Must be >= FFMPEG_TIMEOUT_MS + 60000 (default auto-derived)
# WORKER_LOCK_DURATION_MS=180000
