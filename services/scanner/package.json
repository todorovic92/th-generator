{
  "name": "@thumbnail-generator/scanner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsx --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@thumbnail-generator/config": "*",
    "@thumbnail-generator/db": "*",
    "@thumbnail-generator/filesystem": "*",
    "@thumbnail-generator/logger": "*",
    "@thumbnail-generator/queue": "*",
    "@thumbnail-generator/storage": "*",
    "bullmq": "5.61.0",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "tsx": "4.20.6"
  }
}
